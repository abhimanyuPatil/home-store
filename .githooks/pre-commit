#!/usr/bin/env bash

set -euo pipefail

repository_root="$(git rev-parse --show-toplevel)"

run_checks() {
  local project_directory="$1"

  echo "Running format check in ${project_directory}..."
  (cd "${repository_root}/${project_directory}" && npm run format)

  echo "Running lint check in ${project_directory}..."
  (cd "${repository_root}/${project_directory}" && npm run lint)
}

run_checks backend
run_checks frontend

echo "Pre-commit checks passed."
